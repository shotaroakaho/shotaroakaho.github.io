  },
  "homepage": "https://github.com/shotaroakaho/shotaroakaho-portfolio#readme",
  "devDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0",
    "postcss-selector-parser": "^7.1.7"
  },
