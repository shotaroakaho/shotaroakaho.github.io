    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "pagefind": "^1.5.2",
    "preact": "^10.29.8"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shotaroakaho/shotaroakaho-portfolio.git"
  },
